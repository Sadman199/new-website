APP_NAME=BrokersCourt
APP_ENV=staging
# Generate a fresh key on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.brokerscourt.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite: leave DB_DATABASE unset so Laravel resolves to database/database.sqlite
# inside the app automatically. Only set it if your DB lives elsewhere, and if
# so use a FULL absolute path (run `pwd` in the project root to find it).
DB_CONNECTION=sqlite
# DB_DATABASE=/full/absolute/path/to/database/database.sqlite
DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie hardening (requires HTTPS on the subdomain)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

# Use a DEDICATED staging mailbox or a catch-all (e.g. Mailtrap) so staging
# never sends mail to real users. Do NOT reuse production credentials.
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="staging@brokerscourt.com"
MAIL_FROM_NAME="${APP_NAME} (Staging)"

# Use separate staging reCAPTCHA keys if available
RECAPTCHA_SITEKEY=
RECAPTCHA_SECRET=
