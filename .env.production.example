APP_NAME=BrokersCourt
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.brokerscourt.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Create the user + database in cPanel → MySQL Databases.
# Never use root. Never leave DB_PASSWORD empty on production.
# On Linux/cPanel, DB_HOST=localhost is normal (socket). On Windows dev, use 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=brokerscourt_data
DB_USERNAME=brokerscourt_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_STRICT_PRODUCTION=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.brokerscourt.com
MAIL_PORT=465
MAIL_USERNAME=info@brokerscourt.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@brokerscourt.com
MAIL_FROM_NAME="Team BrokersCourt"

RECAPTCHA_SITEKEY=
RECAPTCHA_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
