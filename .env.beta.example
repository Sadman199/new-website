APP_NAME=BrokersCourt
APP_ENV=beta
# Generate a fresh key on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://beta.brokerscourt.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Prefer a dedicated MySQL DB for beta (create in cPanel → MySQL Databases).
# Example values — replace with what cPanel shows:
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOURUSER_brokerscourt_beta
DB_USERNAME=YOURUSER_beta
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=5

# Or use SQLite instead (comment MySQL block above and uncomment):
# DB_CONNECTION=sqlite
# DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="beta@brokerscourt.com"
MAIL_FROM_NAME="${APP_NAME} (Beta)"

RECAPTCHA_SITEKEY=
RECAPTCHA_SECRET=
